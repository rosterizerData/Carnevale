        "rules": {
          "detectFactionTheGuild": {
            "evals": [
              {
                "min": 1,
                "not": false,
                "paths": [
                  [
                    "{self}",
                    "included",
                    "Character",
                    "tally",
                    "The Guild"
                  ]
                ],
                "operator": "SUM",
                "actionable": true
              }
            ],
            "order": 1,
            "actions": [
              {
                "paths": [
                  [
                    "{self}",
                    "stats",
                    "Faction",
                    "value"
                  ]
                ],
                "value": "The Guild",
                "actionType": "set",
                "iterations": 1
              }
            ],
            "evaluate": "AND",
            "failState": "pass"
          },
          "setFactionConstraints": {
            "evals": [
              {
                "not": true,
                "paths": [
                  [
                    "{self}",
                    "stats",
                    "Faction",
                    "value"
                  ]
                ],
                "value": "-",
                "operator": "AND",
                "actionable": true
              }
            ],
            "order": 10,
            "actions": [
              {
                "paths": [
                  [
                    "{self}",
                    "constraints",
                    "any"
                  ]
                ],
                "value": [
                  "{this}",
                  "evals",
                  "0",
                  "result",
                  "string"
                ],
                "actionType": "add",
                "iterations": 1
              }
            ],
            "evaluate": "AND",
            "failState": "pass"
          },
